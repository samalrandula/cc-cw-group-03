          "name": "Submit salary",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"company\": \"Acme Corp\",\n  \"country\": \"LK\",\n  \"role\": \"Software Engineer\",\n  \"salary\": 150000,\n  \"yearsOfExperience\": 3,\n  \"experienceLevel\": \"MID\",\n  \"currency\": \"LKR\",\n  \"anonymize\": false\n}"
            },
            "url": "{{salaryBase}}/submit"
          }
        },
        {
          "name": "Get submission by id",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{salaryBase}}/api/submissions/{{submissionId}}"
          }
        },
        {
          "name": "Update submission status",
          "description": "Query `status`: `PENDING`, `APPROVED`, `REJECTED`, or `ADMIN_REJECTED`. `ADMIN_REJECTED` is final — PUTs to any other status are ignored (no row change). There is no `FLAGGED`.",
          "request": {
            "method": "PUT",
            "header": [],
            "url": {
              "raw": "{{salaryBase}}/api/submissions/{{submissionId}}/status?status=APPROVED",
              "host": ["{{salaryBase}}"],
              "path": ["api", "submissions", "{{submissionId}}", "status"],
              "query": [{ "key": "status", "value": "APPROVED" }]
            }
          }
        }
      ]
    },
    {
