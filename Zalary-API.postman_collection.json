{
  "info": {
    "_postman_id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
    "name": "Zalary API",
    "description": "Local defaults match application.properties in this repo (BFF 8090, identity 8081, salary 8082, vote 8083, search 8084 per BFF wiring, stats 8085). Login requests save Bearer token to collection variable accessToken.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "bffBase", "value": "http://localhost:8090" },
    { "key": "identityBase", "value": "http://localhost:8081" },
    { "key": "salaryBase", "value": "http://localhost:8082" },
    { "key": "voteBase", "value": "http://localhost:8083" },
    { "key": "searchBase", "value": "http://localhost:8084" },
    { "key": "statsBase", "value": "http://localhost:8085" },
    { "key": "accessToken", "value": "" },
    { "key": "submissionId", "value": "1" },
    { "key": "userId", "value": "1" },
    { "key": "salaryId", "value": "1" }
  ],
  "item": [
    {
      "name": "BFF",
      "item": [
        {
          "name": "Health test",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{bffBase}}/test"
          }
        },
        {
          "name": "Submit salary",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"company\": \"Acme Corp\",\n  \"country\": \"LK\",\n  \"role\": \"Software Engineer\",\n  \"salary\": 150000,\n  \"yearsOfExperience\": 3,\n  \"experienceLevel\": \"MID\",\n  \"currency\": \"LKR\",\n  \"anonymize\": false\n}"
            },
            "url": "{{bffBase}}/submit"
          }
        },
        {
          "name": "Signup",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": "{{bffBase}}/signup"
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "try {",
                  "  var j = pm.response.json();",
                  "  if (j && j.token) pm.collectionVariables.set('accessToken', j.token);",
                  "} catch (e) {}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": "{{bffBase}}/login"
          }
        },
        {
          "name": "Vote",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"submissionId\": 1,\n  \"voteType\": \"UPVOTE\"\n}"
            },
            "url": "{{bffBase}}/vote"
          }
        },
        {
          "name": "Report submission",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"submissionId\": 1,\n  \"reason\": \"Inaccurate data\"\n}"
            },
            "url": "{{bffBase}}/report"
          }
        },
        {
          "name": "Search salaries (query → BFF)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{bffBase}}/search?page=0&pageSize=20",
              "host": ["{{bffBase}}"],
              "path": ["search"],
              "query": [
                { "key": "countries", "value": "LK", "disabled": true },
                { "key": "companies", "value": "Acme Corp", "disabled": true },
                { "key": "roles", "value": "Software Engineer", "disabled": true },
                { "key": "levels", "value": "MID", "disabled": true },
                { "key": "minSalary", "value": "100000", "disabled": true },
                { "key": "maxSalary", "value": "500000", "disabled": true },
                { "key": "page", "value": "0" },
                { "key": "pageSize", "value": "20" }
              ]
            }
          }
        },
        {
          "name": "Stats",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{bffBase}}/stats",
              "host": ["{{bffBase}}"],
              "path": ["stats"],
              "query": [
                { "key": "location", "value": "Colombo", "disabled": true },
                { "key": "role", "value": "Software Engineer", "disabled": true },
                { "key": "experienceLevel", "value": "MID", "disabled": true }
              ]
            }
          }
        }
      ]
    },
