# Stage 1: Build Stage
FROM gradle:8.7-jdk21-alpine AS builder
WORKDIR /app

# 1. Copy only the files needed to download dependencies
# This speeds up builds because Docker caches this layer
COPY gradlew .
COPY gradle gradle
COPY build.gradle .
COPY settings.gradle .

# 2. Download dependencies (this layer won't re-run unless build.gradle changes)
RUN ./gradlew dependencies --no-daemon

# 3. Copy the source code and build the JAR
COPY . .
RUN ./gradlew bootJar -x test --no-daemon

# Stage 2: Runtime Stage
FROM eclipse-temurin:21-jre-alpine
WORKDIR /app

# Add a non-root user for security
RUN addgroup -S spring && adduser -S spring -G spring
USER spring:spring

# Copy the JAR from the builder stage
COPY --from=builder /app/build/libs/*.jar app.jar

# stats port
EXPOSE 8085

ENTRYPOINT ["java", "-jar", "app.jar"]