# Build stage
FROM node:20-alpine AS builder

WORKDIR /app

# Accept build args
ARG VITE_API_BASE_URL
ARG VITE_EXCHANGE_API
ARG VITE_COUNTRIES_API
ARG VITE_JOB_ROLES_API

# Set them as env for Vite build
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
ENV VITE_EXCHANGE_API=$VITE_EXCHANGE_API
ENV VITE_COUNTRIES_API=$VITE_COUNTRIES_API
ENV VITE_JOB_ROLES_API=$VITE_JOB_ROLES_API

# Install dependencies
COPY package.json package-lock.json* ./
RUN npm install

# Copy source and build
COPY . .
RUN npm run build

# Serve using nginx
FROM nginx:alpine

COPY --from=builder /app/dist /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]